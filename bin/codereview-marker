#!/usr/bin/env bash
set -euo pipefail

# codereview-marker — single source of truth for review push markers.
# Subcommands: hash, write, base, path, skip-path

usage() {
  echo "Usage: codereview-marker {hash|write|base|path|skip-path}" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

# Must be in a git repo
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "codereview-marker: not in a git repo" >&2
  exit 1
}

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-codereview"
mkdir -p "$CACHE_DIR"
chmod 700 "$CACHE_DIR"

# Project identity: md5 of repo root path, truncated to 8 chars
PROJ_HASH="$(echo -n "$GIT_ROOT" | md5 | cut -c1-8 2>/dev/null || echo -n "$GIT_ROOT" | md5sum | cut -c1-8)"

MARKER_FILE="$CACHE_DIR/${PROJ_HASH}.marker"
SKIP_FILE="$CACHE_DIR/${PROJ_HASH}.skip"

# Excluded files from diff hash
EXCLUDES=(':!CODEREVIEW.md' ':!SECURITY.md' ':!TESTING.md' ':!SPEC.md')

resolve_base() {
  # Three-case fallback: @{upstream} -> origin/<branch> -> empty tree
  local branch
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || branch=""

  if git rev-parse --verify "@{upstream}" &>/dev/null; then
    git rev-parse --verify "@{upstream}"
  elif [[ -n "$branch" ]] && git rev-parse --verify "origin/$branch" &>/dev/null; then
    echo "origin/$branch"
  else
    # Empty tree — new branch, no upstream
    git mktree < /dev/null
  fi
}

compute_hash() {
  local base
  base="$(resolve_base)"
  local diff
  diff="$(git diff "$base" -- "${EXCLUDES[@]}" 2>/dev/null)" || diff=""

  if [[ -z "$diff" ]]; then
    # No reviewable changes
    return 2
  fi

  echo -n "$diff" | shasum -a 256 | cut -c1-16
}

case "$1" in
  hash)
    compute_hash
    ;;
  write)
    hash_val="$(compute_hash)" || exit $?
    echo "$hash_val" > "$MARKER_FILE"
    ;;
  base)
    resolve_base
    ;;
  path)
    echo "$MARKER_FILE"
    ;;
  skip-path)
    echo "$SKIP_FILE"
    ;;
  *)
    usage
    ;;
esac
